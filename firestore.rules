rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isBodeguero() {
      return isSignedIn()
        && (
          request.auth.uid == 'yFNJUJUJiaXbOiHLGGPsIJWShbC2'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'bodeguero'
          )
        );
    }

    function isValidBodegueroOrderTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;

      return (next in ['paid', 'shipped', 'delivered', 'refunded'])
        && (current in ['paid', 'shipped', 'delivered', 'refunded']);
    }

    function canBodegueroUpdateOrder() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return changedKeys.hasOnly([
          'status',
          'updatedAt',
          'warehouseStockStatus',
          'warehouseStockNote',
          'warehouseItemsStatus',
          'warehouseUpdatedBy',
          'warehouseUpdatedAt'
        ])
        && isValidBodegueroOrderTransition()
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() >= 10
        && request.resource.data.updatedAt.size() <= 40
        && (!request.resource.data.keys().hasAny(['warehouseStockStatus']) || request.resource.data.warehouseStockStatus in ['unknown', 'in_stock', 'out_of_stock'])
        && (!request.resource.data.keys().hasAny(['warehouseStockNote']) || (
          request.resource.data.warehouseStockNote is string
          && request.resource.data.warehouseStockNote.size() <= 200
        ))
        && (!request.resource.data.keys().hasAny(['warehouseItemsStatus']) || request.resource.data.warehouseItemsStatus is map)
        && (!request.resource.data.keys().hasAny(['warehouseUpdatedBy']) || request.resource.data.warehouseUpdatedBy == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['warehouseUpdatedAt']) || (
          request.resource.data.warehouseUpdatedAt is string
          && request.resource.data.warehouseUpdatedAt.size() >= 10
          && request.resource.data.warehouseUpdatedAt.size() <= 40
        ));
    }

    // El usuario solo puede modificar campos de perfil permitidos y NUNCA
    // puede tocar uid, role ni permissions (aunque esos campos no existan aún).
    // Usar diff().affectedKeys() evita depender de campos que podrían no existir.
    function unchangedProtectedUserFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['uid', 'role', 'permissions']);
    }

    function isSafeString(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen;
    }

    function hasValidShippingData() {
      let shipping = request.resource.data.shippingData;
      return shipping is map
        && shipping.keys().hasAll([
          'firstName',
          'lastName',
          'email',
          'phone',
          'street',
          'city',
          'region'
        ])
        && shipping.keys().hasOnly([
          'firstName',
          'lastName',
          'rut',
          'email',
          'phone',
          'street',
          'apartment',
          'city',
          'region',
          'notes'
        ])
        && isSafeString(shipping.firstName, 2, 80)
        && isSafeString(shipping.lastName, 2, 80)
        && isSafeString(shipping.email, 5, 254)
        && shipping.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && isSafeString(shipping.phone, 7, 20)
        && isSafeString(shipping.street, 5, 160)
        && isSafeString(shipping.city, 2, 100)
        && isSafeString(shipping.region, 2, 100)
        && (!shipping.keys().hasAny(['apartment']) || isSafeString(shipping.apartment, 0, 80))
        && (!shipping.keys().hasAny(['notes']) || isSafeString(shipping.notes, 0, 500))
        && (!shipping.keys().hasAny(['rut']) || isSafeString(shipping.rut, 0, 20));
    }

    function hasValidOrderItems() {
      return request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.items.all(item,
          item is map
          && item.keys().hasAll(['id', 'quantity'])
          && item.id is string
          && item.id.size() > 0
          && item.id.size() <= 120
          && item.quantity is int
          && item.quantity > 0
          && item.quantity <= 100
          && (!item.keys().hasAny(['price']) || (
            item.price is number
            && item.price >= 0
            && item.price <= 2000000
          ))
        );
    }

    function hasValidOrderCreateShape(orderId) {
      return request.resource.data.keys().hasAll([
          'id',
          'userId',
          'items',
          'shippingData',
          'totals',
          'status',
          'paymentMethod',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'userName',
          'userEmail',
          'items',
          'shippingData',
          'totals',
          'status',
          'paymentMethod',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'mercado_pago'
        && hasValidOrderItems()
        && hasValidShippingData()
        && request.resource.data.totals is map
        && request.resource.data.totals.keys().hasAll(['subtotal', 'shipping', 'discount', 'total'])
        && request.resource.data.totals.subtotal is number
        && request.resource.data.totals.shipping is number
        && request.resource.data.totals.discount is number
        && request.resource.data.totals.total is number
        && request.resource.data.totals.subtotal >= 0
        && request.resource.data.totals.shipping >= 0
        && request.resource.data.totals.discount >= 0
        && request.resource.data.totals.total >= 0
        && request.resource.data.totals.discount <= (request.resource.data.totals.subtotal + request.resource.data.totals.shipping)
        && request.resource.data.totals.total == (
          request.resource.data.totals.subtotal
          + request.resource.data.totals.shipping
          - request.resource.data.totals.discount
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'client';

      allow update: if isAdmin()
        || (isOwner(userId) && unchangedProtectedUserFields());

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if isAdmin()
        || (
          isSignedIn()
          && hasValidOrderCreateShape(orderId)
        );

      allow read: if isAdmin()
        || isBodeguero()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
        || (isBodeguero() && canBodegueroUpdateOrder());

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      allow update: if isBodeguero()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'active', 'updatedAt'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.active is bool;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /configuracion/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /hairAnalysisConsents/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /hairAnalysisTrainingSamples/{sampleId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /discountCodes/{discountId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /userCarts/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /analyticsVisits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['date', 'visitorId', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 16
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.createdAt is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /shippingData/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
