# Monsite Backend - Variables de Entorno

# Entorno
NODE_ENV=development
PORT=3000

# Frontend permitido por CORS (usar una o varias URLs separadas por coma)
FRONTEND_URL=http://localhost:5500
FRONTEND_URLS=http://localhost:5500,http://127.0.0.1:5500

# URL de webhook pública (ngrok en desarrollo, dominio backend en producción)
WEBHOOK_URL=https://tu-backend-publico.com/webhook/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=define_el_webhook_secret_de_mercadopago
# Opcional en desarrollo: forzar auto_return aunque FRONTEND_URL no sea https
MP_FORCE_AUTO_RETURN=false

# Rate limiting (ajustar según tráfico)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
PAYMENT_RATE_LIMIT_WINDOW_MS=600000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=60

# Seguridad API backend
BACKEND_API_KEY=define_una_clave_segura_aqui
WEBHOOK_TOKEN=define_un_token_webhook_seguro_aqui

# Firebase Admin SDK (para script seguro de admins)
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com

# Email transaccional SMTP (opcional hasta configurar proveedor)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASSWORD=define-esta-variable-en-tu-entorno
EMAIL_FROM="Monsite <no-reply@example.com>"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Alternativa: ruta a archivo JSON de service account
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Mercado Pago
# Checkout Pro: solo el Access Token es requerido en backend
MERCADOPAGO_PUBLIC_KEY=tu_public_key_aqui
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui

# Twilio (WhatsApp Notifications)
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+569XXXXXXXX

